{
  "manifest_version": 3,
  "name": "BD Price Tracker",
  "version": "1.0",
  "description": "Track prices on Daraz BD, Startech, Rokomari, and Pickaboo.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://www.daraz.com.bd/*",
    "https://www.startech.com.bd/*",
    "https://www.rokomari.com/*",
    "https://www.pickaboo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png" 
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.daraz.com.bd/*",
        "https://www.startech.com.bd/*",
        "https://www.rokomari.com/*",
        "https://www.pickaboo.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
